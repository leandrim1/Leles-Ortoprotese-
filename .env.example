# Banco de dados — Neon PostgreSQL
# Painel do Neon > Connection string (use a string com pooling para serverless).
DATABASE_URL="postgresql://usuario:senha@ep-exemplo.sa-east-1.aws.neon.tech/lableles?sslmode=require"

# Armazenamento — Vercel Blob
# Vercel > Storage > Blob > Tokens. Este token NUNCA vai para o navegador.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx"

# URL pública da aplicação, usada em links de download e e-mails.
APP_URL="https://lableles.com.br"

# Define se o cookie de sessão exige HTTPS. Use false apenas em desenvolvimento.
COOKIE_SECURE="true"

# Provisionamento do primeiro administrador (scripts/create-admin.ts).
# Preencha apenas na hora de rodar o script e remova em seguida.
ADMIN_EMAIL=""
ADMIN_NAME=""
